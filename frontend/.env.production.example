# ComplianceCore frontend — PRODUCTION build vars.
# Vite inlines these at BUILD time, so they must be present when `vite build`
# runs (set them in Vercel Project Settings -> Environment Variables, or as
# Docker build args). They are PUBLIC — never put secrets here.

# Base URL of the deployed API (no trailing slash)
VITE_API_URL=https://api.compliancecore.io

VITE_APP_ENV=production
VITE_APP_NAME=ComplianceCore
