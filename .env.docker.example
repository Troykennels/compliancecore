# Copy to .env for `docker compose up`. Compose injects DATABASE_URL / REDIS_URL
# for the api service automatically (pointing at the postgres/redis services),
# so you only need to fill the app secrets below.

# Local Postgres bootstrap (compose reads these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=compliancecore

# Frontend build arg
VITE_API_URL=http://localhost:3002

# ─── App secrets (same keys as backend/.env.production.example) ──────────────
JWT_PRIVATE_KEY_BASE64=<base64_encoded_rsa_private_key>
JWT_PUBLIC_KEY_BASE64=<base64_encoded_rsa_public_key>
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
ENCRYPTION_KEY=<64_hex_chars>
COOKIE_SECRET=<64_hex_chars>
FRONTEND_URL=http://localhost:8080

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<user>
SMTP_PASS=<pass>
EMAIL_FROM=ComplianceCore <noreply@compliancecore.io>

AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>
AWS_REGION=eu-west-1
AWS_S3_BUCKET=compliancecore-evidence-dev
OCR_PROVIDER=none

GROQ_API_KEY=<groq_api_key>
