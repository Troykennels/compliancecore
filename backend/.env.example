# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliancecore?schema=global

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate: openssl genrsa -out private.key 2048 && openssl rsa -in private.key -pubout -out public.key
# Then base64 encode: base64 -w 0 private.key
JWT_PRIVATE_KEY_BASE64=<base64_encoded_rsa_private_key>
JWT_PUBLIC_KEY_BASE64=<base64_encoded_rsa_public_key>
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── Encryption (for MFA secrets at rest) ─────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=<64_hex_chars_256_bit_key>

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<ethereal_user>
SMTP_PASS=<ethereal_pass>
EMAIL_FROM=ComplianceCore <noreply@compliancecore.io>

# ─── S3 ───────────────────────────────────────────────────────────────────────
AWS_S3_BUCKET=compliancecore-evidence
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>

# ─── Cookies ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
COOKIE_SECRET=<64_hex_chars>

# ─── Groq (AI) ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=<groq_api_key>

# ─── OCR ───────────────────────────────────────────────────────────────────────
OCR_PROVIDER=textract
