# ─────────────────────────────────────────────────────────────────────────────
# ComplianceCore API — PRODUCTION environment variables
# Copy the real values into your host's secret manager (Railway Variables,
# GitHub Actions secrets, etc). NEVER commit the filled-in version.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
# Public URL of the deployed frontend — drives CORS allow-origin. No trailing slash.
FRONTEND_URL=https://app.compliancecore.io

# ─── Database (Railway Postgres injects DATABASE_URL automatically) ───────────
# Keep ?schema=global — the app is schema-per-tenant with a global schema.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/compliancecore?schema=global

# ─── Redis (Railway Redis injects REDIS_URL automatically) ───────────────────
REDIS_URL=redis://default:PASSWORD@HOST:6379

# ─── JWT (RS256) ─────────────────────────────────────────────────────────────
# Generate once:
#   openssl genrsa -out private.key 2048
#   openssl rsa -in private.key -pubout -out public.key
#   base64 -w 0 private.key   (macOS: base64 -i private.key)
JWT_PRIVATE_KEY_BASE64=<base64_encoded_rsa_private_key>
JWT_PUBLIC_KEY_BASE64=<base64_encoded_rsa_public_key>
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── Encryption (MFA secrets at rest) — openssl rand -hex 32 ─────────────────
ENCRYPTION_KEY=<64_hex_chars_256_bit_key>

# ─── Cookie signing — openssl rand -hex 32 (min 32 chars) ────────────────────
COOKIE_SECRET=<64_hex_chars>

# ─── Digital signatures — server-only HMAC key, openssl rand -hex 32 ─────────
# Required (>=32 chars, no default). E-signatures are only tamper-proof while
# this stays secret.
SIGNATURE_SECRET=<64_hex_chars>

# ─── Email / SMTP (use a real provider in prod: SES, Postmark, Resend) ───────
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp_user>
SMTP_PASS=<smtp_pass>
EMAIL_FROM=ComplianceCore <noreply@compliancecore.io>

# ─── AWS / S3 (evidence storage) + Textract (OCR) ────────────────────────────
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>
AWS_REGION=eu-west-1
AWS_S3_BUCKET=compliancecore-evidence-prod

# OCR provider: 'textract' (AWS) or 'none' to disable OCR entirely
OCR_PROVIDER=textract

# ─── Groq (AI features) ──────────────────────────────────────────────────────
GROQ_API_KEY=<groq_api_key>
